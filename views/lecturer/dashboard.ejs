<%- include('../partials/header') %>
<%- include('../partials/navbar-lecturer') %>

<div class="ttv-layout">
  <%- include('../partials/sidebar-lecturer') %>

  <main class="ttv-main">
    <div class="ttv-page-header">
      <h1 class="ttv-page-title">Welcome, <%= user.name %></h1>
      <p class="ttv-page-subtitle">Lecturer Dashboard</p>
    </div>

    <div class="ttv-stats-grid ttv-stats-grid-3">
      <div class="ttv-stat-card">
        <div class="ttv-stat-icon ttv-stat-icon-primary"><i class="bi bi-calendar-week"></i></div>
        <div class="ttv-stat-body">
          <div class="ttv-stat-value"><%= totalClasses %></div>
          <div class="ttv-stat-label">Scheduled Classes</div>
        </div>
      </div>
    </div>

    <div class="ttv-card">
      <div class="ttv-card-body">
        <div class="ttv-quick-actions">
          <a href="/lecturer/schedule" class="ttv-btn ttv-btn-primary" id="lec-schedule-btn">
            <i class="bi bi-calendar-week"></i> View My Schedule
          </a>
        </div>
      </div>
    </div>
  </main>
</div>

<%- include('../partials/footer') %>
