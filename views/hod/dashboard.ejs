<%- include('../partials/header') %>
<%- include('../partials/navbar-hod') %>

<div class="ttv-layout">
  <%- include('../partials/sidebar-hod') %>

  <main class="ttv-main">
    <div class="ttv-page-header">
      <h1 class="ttv-page-title">HOD Dashboard</h1>
      <p class="ttv-page-subtitle">Welcome, <%= user.name %></p>
    </div>

    <div class="ttv-stats-grid">
      <div class="ttv-stat-card">
        <div class="ttv-stat-icon ttv-stat-icon-warning"><i class="bi bi-pencil-square"></i></div>
        <div class="ttv-stat-body">
          <div class="ttv-stat-value"><%= stats.draftEntries %></div>
          <div class="ttv-stat-label">Pending Approval</div>
        </div>
      </div>
      <div class="ttv-stat-card">
        <div class="ttv-stat-icon ttv-stat-icon-success"><i class="bi bi-check-circle"></i></div>
        <div class="ttv-stat-body">
          <div class="ttv-stat-value"><%= stats.publishedEntries %></div>
          <div class="ttv-stat-label">Published</div>
        </div>
      </div>
      <div class="ttv-stat-card">
        <div class="ttv-stat-icon ttv-stat-icon-primary"><i class="bi bi-book"></i></div>
        <div class="ttv-stat-body">
          <div class="ttv-stat-value"><%= stats.totalCourses %></div>
          <div class="ttv-stat-label">Total Courses</div>
        </div>
      </div>
      <div class="ttv-stat-card">
        <div class="ttv-stat-icon ttv-stat-icon-info"><i class="bi bi-people"></i></div>
        <div class="ttv-stat-body">
          <div class="ttv-stat-value"><%= stats.totalLecturers %></div>
          <div class="ttv-stat-label">Lecturers</div>
        </div>
      </div>
    </div>

    <div class="ttv-card">
      <div class="ttv-card-body">
        <div class="ttv-quick-actions">
          <a href="/hod/timetable" class="ttv-btn ttv-btn-primary" id="hod-review-btn">
            <i class="bi bi-calendar-check"></i> Review Timetable
          </a>
        </div>
      </div>
    </div>
  </main>
</div>

<%- include('../partials/footer') %>
