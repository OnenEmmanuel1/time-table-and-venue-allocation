<%- include('../partials/header') %>
<%- include('../partials/navbar-admin') %>

<div class="ttv-layout">
  <%- include('../partials/sidebar-admin') %>

  <main class="ttv-main">
    <div class="ttv-page-header">
      <h1 class="ttv-page-title">Dashboard</h1>
      <p class="ttv-page-subtitle">Overview of system data and scheduling status</p>
    </div>

    <!-- Stats Grid -->
    <div class="ttv-stats-grid ttv-stats-grid-5">
      <div class="ttv-stat-card" id="stat-courses">
        <div class="ttv-stat-icon ttv-stat-icon-primary"><i data-lucide="book"></i></div>
        <div class="ttv-stat-body">
          <div class="ttv-stat-value"><%= stats.totalCourses %></div>
          <div class="ttv-stat-label">Courses</div>
        </div>
      </div>
      <div class="ttv-stat-card" id="stat-lecturers">
        <div class="ttv-stat-icon ttv-stat-icon-info"><i data-lucide="users"></i></div>
        <div class="ttv-stat-body">
          <div class="ttv-stat-value"><%= stats.totalLecturers %></div>
          <div class="ttv-stat-label">Lecturers</div>
        </div>
      </div>
      <div class="ttv-stat-card" id="stat-students">
        <div class="ttv-stat-icon ttv-stat-icon-info" style="background: #EDE9FE; color: #7C3AED;"><i data-lucide="graduation-cap"></i></div>
        <div class="ttv-stat-body">
          <div class="ttv-stat-value"><%= stats.totalStudents || 0 %></div>
          <div class="ttv-stat-label">Students</div>
        </div>
      </div>
      <div class="ttv-stat-card" id="stat-venues">
        <div class="ttv-stat-icon ttv-stat-icon-success"><i data-lucide="building"></i></div>
        <div class="ttv-stat-body">
          <div class="ttv-stat-value"><%= stats.totalVenues %></div>
          <div class="ttv-stat-label">Venues</div>
        </div>
      </div>
      <div class="ttv-stat-card" id="stat-slots">
        <div class="ttv-stat-icon ttv-stat-icon-warning"><i data-lucide="clock"></i></div>
        <div class="ttv-stat-body">
          <div class="ttv-stat-value"><%= stats.totalSlots %></div>
          <div class="ttv-stat-label">Time Slots</div>
        </div>
      </div>
    </div>

    <!-- Timetable Status -->
    <div class="ttv-stats-grid ttv-stats-grid-3">
      <div class="ttv-stat-card" id="stat-draft">
        <div class="ttv-stat-icon ttv-stat-icon-warning"><i data-lucide="edit"></i></div>
        <div class="ttv-stat-body">
          <div class="ttv-stat-value"><%= stats.draftEntries %></div>
          <div class="ttv-stat-label">Draft Entries</div>
        </div>
      </div>
      <div class="ttv-stat-card" id="stat-published">
        <div class="ttv-stat-icon ttv-stat-icon-success"><i data-lucide="check-circle"></i></div>
        <div class="ttv-stat-body">
          <div class="ttv-stat-value"><%= stats.publishedEntries %></div>
          <div class="ttv-stat-label">Published Entries</div>
        </div>
      </div>
      <div class="ttv-stat-card" id="stat-conflicts">
        <div class="ttv-stat-icon ttv-stat-icon-error"><i data-lucide="alert-triangle"></i></div>
        <div class="ttv-stat-body">
          <div class="ttv-stat-value"><%= stats.totalConflicts %></div>
          <div class="ttv-stat-label">Conflicts Resolved</div>
        </div>
      </div>
    </div>

    <!-- Quick Actions -->
    <div class="ttv-card">
      <div class="ttv-card-header">
        <h2 class="ttv-card-title">Quick Actions</h2>
      </div>
      <div class="ttv-card-body">
        <div class="ttv-quick-actions">
          <a href="/admin/courses" class="ttv-btn ttv-btn-primary" id="quick-courses">
            <i data-lucide="book"></i> Manage Courses
          </a>
          <a href="/admin/students" class="ttv-btn ttv-btn-primary" id="quick-students" style="background:#7C3AED;">
            <i data-lucide="graduation-cap"></i> Manage Students
          </a>
          <a href="/admin/timetable" class="ttv-btn ttv-btn-info" id="quick-timetable">
            <i data-lucide="calendar"></i> View Timetable
          </a>
          <a href="/admin/conflicts" class="ttv-btn ttv-btn-secondary" id="quick-conflicts">
            <i data-lucide="alert-triangle"></i> Conflict Log
          </a>
        </div>
      </div>
    </div>
  </main>
</div>

<%- include('../partials/footer') %>
